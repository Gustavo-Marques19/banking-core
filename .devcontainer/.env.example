# Copie para .devcontainer/.env e troque os valores. O .env não é versionado.
# Mudar as senhas do Postgres depois da primeira subida exige apagar o volume pgdata,
# porque o script de roles só roda na criação do volume.
POSTGRES_PASSWORD=
BANKING_MIGRATOR_PASSWORD=
BANKING_APP_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
