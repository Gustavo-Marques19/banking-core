{
  "realm": "banking",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "customer",
        "description": "Dono de contas. Movimenta só as próprias."
      },
      {
        "name": "operator",
        "description": "Faz depósitos de dinheiro fictício e aprova operações de outro operador."
      },
      {
        "name": "admin",
        "description": "Configura o mock do provider e verifica a trilha de auditoria."
      }
    ]
  },
  "clients": [
    {
      "clientId": "banking-api",
      "name": "Banking API",
      "description": "Representa a API como audience dos tokens. Não inicia login.",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "banking-cli",
      "name": "Banking CLI (só desenvolvimento)",
      "description": "Cliente público com password grant para a demo e testes manuais. Não usar fora de desenvolvimento.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience banking-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "banking-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "banking-backoffice",
      "name": "Backoffice (BFF)",
      "description": "Usado só pelo BFF do backoffice. Authorization code com PKCE; o navegador nunca recebe token. https://localhost é o host dos testes. O terceiro endereço vem de BACKOFFICE_PUBLIC_URL (Codespaces).",
      "enabled": true,
      "publicClient": false,
      "secret": "backoffice-dev-only",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5180/signin-oidc",
        "https://localhost/signin-oidc",
        "${BACKOFFICE_PUBLIC_URL:http://localhost:5180}/signin-oidc"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5180/##https://localhost/##${BACKOFFICE_PUBLIC_URL:http://localhost:5180}/"
      },
      "protocolMappers": [
        {
          "name": "audience banking-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "banking-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "banking-web",
      "name": "App do cliente (BFF)",
      "description": "Usado só pelo BFF do app do cliente, mesma configuração do backoffice com outro segredo e outra porta. https://localhost é o host dos testes. O terceiro endereço vem de CUSTOMER_PUBLIC_URL (Codespaces).",
      "enabled": true,
      "publicClient": false,
      "secret": "web-dev-only",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5190/signin-oidc",
        "https://localhost/signin-oidc",
        "${CUSTOMER_PUBLIC_URL:http://localhost:5190}/signin-oidc"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5190/##https://localhost/##${CUSTOMER_PUBLIC_URL:http://localhost:5190}/"
      },
      "protocolMappers": [
        {
          "name": "audience banking-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "banking-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
